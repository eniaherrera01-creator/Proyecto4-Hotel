        <SQLTask:SqlTaskData
          SQLTask:Connection="{51D25BC2-65B0-41BB-8391-60088F7279E7}"
          SQLTask:SqlStatementSource="IF EXISTS (&#xA;    SELECT *&#xA;    FROM INFORMATION_SCHEMA.TABLES&#xA;    WHERE TABLE_NAME = 'Hechos_ventas'&#xA;)&#xA;BEGIN&#xA;    DROP TABLE [dbo].[Hechos_ventas];&#xA;END&#xA;GO&#xA;&#xA;TRUNCATE TABLE [dbo].[DM Clientes];&#xA;TRUNCATE TABLE [dbo].[DM Compras];&#xA;TRUNCATE TABLE [dbo].[DM Detalle_Compra];&#xA;TRUNCATE TABLE [dbo].[DM Detalle_Reservacion];&#xA;TRUNCATE TABLE [dbo].[DM Detalle_Servicio];&#xA;TRUNCATE TABLE [dbo].[DM Empleados];&#xA;TRUNCATE TABLE [dbo].[DM Habitaciones];&#xA;TRUNCATE TABLE [dbo].[DM Planilla];&#xA;TRUNCATE TABLE [dbo].[DM Productos];&#xA;TRUNCATE TABLE [dbo].[DM Proveedores];&#xA;TRUNCATE TABLE [dbo].[DM Reservaciones];&#xA;TRUNCATE TABLE [dbo].[DM Servicios];&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
