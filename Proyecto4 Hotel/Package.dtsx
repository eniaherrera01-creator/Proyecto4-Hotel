          SQLTask:Connection="{13F50FE5-B2B9-4F32-9556-0FBB3F4E200B}"
          SQLTask:SqlStatementSource="USE [DW Sistema_Hotel]&#xA;GO&#xA;&#xA;/****** Object:  Table [dbo].[Hechos_ventas]    Script Date: 8/1/2026 6:59:32 PM ******/&#xA;SET ANSI_NULLS ON&#xA;GO&#xA;&#xA;SET QUOTED_IDENTIFIER ON&#xA;GO&#xA;&#xA;CREATE TABLE [dbo].[Hechos_ventas](&#xA;&#x9;[codigo_venta] [int] NOT NULL,&#xA;&#x9;[IdCliente] [int] NOT NULL,&#xA;&#x9;[IdCompra] [int] NOT NULL,&#xA;&#x9;[IdEmpleado] [int] NOT NULL,&#xA;&#x9;[IdPlanilla] [int] NOT NULL,&#xA;&#x9;[IdHabitacion] [int] NOT NULL,&#xA;&#x9;[IdReservacion] [int] NOT NULL,&#xA;&#x9;[IdProveedor] [int] NOT NULL,&#xA;&#x9;[IdDetalleCompra] [int] NOT NULL,&#xA;&#x9;[IdProductos] [int] NOT NULL,&#xA;&#x9;[IdDetalle] [int] NOT NULL,&#xA;&#x9;[IdServicio] [int] NOT NULL,&#xA;&#x9;[IdDetalleServicio] [int] IDENTITY(1,1) NOT NULL&#xA;) ON [PRIMARY]&#xA;GO&#xA;&#xA;ALTER TABLE [dbo].[Hechos_ventas]  WITH CHECK ADD  CONSTRAINT [FK_Hechos_ventas_DM Clientes] FOREIGN KEY([IdCliente])&#xA;REFERENCES [dbo].[DM Clientes] ([IdCliente])&#xA;GO&#xA;&#xA;ALTER TABLE [dbo].[Hechos_ventas] CHECK CONSTRAINT [FK_Hechos_ventas_DM Clientes]&#xA;GO&#xA;&#xA;ALTER TABLE [dbo].[Hechos_ventas]  WITH CHECK ADD  CONSTRAINT [FK_Hechos_ventas_DM Compras] FOREIGN KEY([IdCompra])&#xA;REFERENCES [dbo].[DM Compras] ([IdCompra])&#xA;GO&#xA;&#xA;ALTER TABLE [dbo].[Hechos_ventas] CHECK CONSTRAINT [FK_Hechos_ventas_DM Compras]&#xA;GO&#xA;&#xA;ALTER TABLE [dbo].[Hechos_ventas]  WITH CHECK ADD  CONSTRAINT [FK_Hechos_ventas_DM Detalle_Compra] FOREIGN KEY([IdDetalleCompra])&#xA;REFERENCES [dbo].[DM Detalle_Compra] ([IdDetalleCompra])&#xA;GO&#xA;&#xA;ALTER TABLE [dbo].[Hechos_ventas] CHECK CONSTRAINT [FK_Hechos_ventas_DM Detalle_Compra]&#xA;GO&#xA;&#xA;ALTER TABLE [dbo].[Hechos_ventas]  WITH CHECK ADD  CONSTRAINT [FK_Hechos_ventas_DM Detalle_Reservacion] FOREIGN KEY([IdDetalle])&#xA;REFERENCES [dbo].[DM Detalle_Reservacion] ([IdDetalle])&#xA;GO&#xA;&#xA;ALTER TABLE [dbo].[Hechos_ventas] CHECK CONSTRAINT [FK_Hechos_ventas_DM Detalle_Reservacion]&#xA;GO&#xA;&#xA;ALTER TABLE [dbo].[Hechos_ventas]  WITH CHECK ADD  CONSTRAINT [FK_Hechos_ventas_DM Detalle_Servicio] FOREIGN KEY([IdDetalleServicio])&#xA;REFERENCES [dbo].[DM Detalle_Servicio] ([IdDetalleServicio])&#xA;GO&#xA;&#xA;ALTER TABLE [dbo].[Hechos_ventas] CHECK CONSTRAINT [FK_Hechos_ventas_DM Detalle_Servicio]&#xA;GO&#xA;&#xA;ALTER TABLE [dbo].[Hechos_ventas]  WITH CHECK ADD  CONSTRAINT [FK_Hechos_ventas_DM Empleados] FOREIGN KEY([IdEmpleado])&#xA;REFERENCES [dbo].[DM Empleados] ([IdEmpleado])&#xA;GO&#xA;&#xA;ALTER TABLE [dbo].[Hechos_ventas] CHECK CONSTRAINT [FK_Hechos_ventas_DM Empleados]&#xA;GO&#xA;&#xA;ALTER TABLE [dbo].[Hechos_ventas]  WITH CHECK ADD  CONSTRAINT [FK_Hechos_ventas_DM Habitaciones] FOREIGN KEY([IdHabitacion])&#xA;REFERENCES [dbo].[DM Habitaciones] ([IdHabitacion])&#xA;GO&#xA;&#xA;ALTER TABLE [dbo].[Hechos_ventas] CHECK CONSTRAINT [FK_Hechos_ventas_DM Habitaciones]&#xA;GO&#xA;&#xA;ALTER TABLE [dbo].[Hechos_ventas]  WITH CHECK ADD  CONSTRAINT [FK_Hechos_ventas_DM Planilla] FOREIGN KEY([IdPlanilla])&#xA;REFERENCES [dbo].[DM Planilla] ([IdPlanilla])&#xA;GO&#xA;&#xA;ALTER TABLE [dbo].[Hechos_ventas] CHECK CONSTRAINT [FK_Hechos_ventas_DM Planilla]&#xA;GO&#xA;&#xA;ALTER TABLE [dbo].[Hechos_ventas]  WITH CHECK ADD  CONSTRAINT [FK_Hechos_ventas_DM Productos] FOREIGN KEY([IdProductos])&#xA;REFERENCES [dbo].[DM Productos] ([IdProductos])&#xA;GO&#xA;&#xA;ALTER TABLE [dbo].[Hechos_ventas] CHECK CONSTRAINT [FK_Hechos_ventas_DM Productos]&#xA;GO&#xA;&#xA;ALTER TABLE [dbo].[Hechos_ventas]  WITH CHECK ADD  CONSTRAINT [FK_Hechos_ventas_DM Proveedores] FOREIGN KEY([IdProveedor])&#xA;REFERENCES [dbo].[DM Proveedores] ([IdProveedor])&#xA;GO&#xA;&#xA;ALTER TABLE [dbo].[Hechos_ventas] CHECK CONSTRAINT [FK_Hechos_ventas_DM Proveedores]&#xA;GO&#xA;&#xA;ALTER TABLE [dbo].[Hechos_ventas]  WITH CHECK ADD  CONSTRAINT [FK_Hechos_ventas_DM Reservaciones] FOREIGN KEY([IdReservacion])&#xA;REFERENCES [dbo].[DM Reservaciones] ([IdReservacion])&#xA;GO&#xA;&#xA;ALTER TABLE [dbo].[Hechos_ventas] CHECK CONSTRAINT [FK_Hechos_ventas_DM Reservaciones]&#xA;GO&#xA;&#xA;ALTER TABLE [dbo].[Hechos_ventas]  WITH CHECK ADD  CONSTRAINT [FK_Hechos_ventas_DM Servicios] FOREIGN KEY([IdServicio])&#xA;REFERENCES [dbo].[DM Servicios] ([IdServicio])&#xA;GO&#xA;&#xA;ALTER TABLE [dbo].[Hechos_ventas] CHECK CONSTRAINT [FK_Hechos_ventas_DM Servicios]&#xA;GO&#xA;&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
